@page "/orders"
@page "/pedidos"
@implements IDisposable
@using TiendaBarrio.Web.Models
@using TiendaBarrio.Web.Services
@inject ApiClient Api
@inject AuthSession Session
@inject ToastService Toast

<PageTitle>Gestión de Pedidos - Tienda Don Julio</PageTitle>

<div class="dashboard-bg pt-4">
    <div class="container-fluid px-4">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bolder mb-1" style="color: #0f172a; letter-spacing: -0.025em;">Gestión de Pedidos</h2>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Monitoreo, atención e historial de compras de los clientes.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-modern btn-light border shadow-sm" @onclick="CargarPedidos">
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                </button>
                @if (Session.IsWorker)
                {
                    <span class="badge badge-soft-primary shadow-sm"><i class="bi bi-shield-check me-1"></i> Modo Personal</span>
                }
            </div>
        </div>

        @if (!Session.IsWorker)
        {
            <div class="glass-card p-4 text-center my-4">
                <i class="bi bi-shield-lock fs-1 text-warning d-block mb-2"></i>
                <h5 class="fw-bold text-dark">Acceso Restringido</h5>
                <p class="text-muted mb-0">Esta sección está disponible únicamente para el personal de la tienda.</p>
            </div>
        }
        else
        {
            <!-- METRICAS DE RESUMEN -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center">
                        <div class="metric-icon-circle bg-primary bg-opacity-10 me-3 text-primary">
                            <i class="bi bi-bag-check fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold">Total Pedidos</span>
                            <h4 class="fw-bold mb-0 text-dark">@orders.Count</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center">
                        <div class="metric-icon-circle bg-warning bg-opacity-10 me-3 text-warning">
                            <i class="bi bi-clock-history fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold">Pendientes</span>
                            <h4 class="fw-bold mb-0 text-dark">@orders.Count(o => o.Status == "Pendiente")</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center">
                        <div class="rmetric-icon-circle bg-info bg-opacity-10 me-3 text-info">
                            <i class="bi bi-gear-wide-connected fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold">En Proceso</span>
                            <h4 class="fw-bold mb-0 text-dark">@orders.Count(o => o.Status == "EnProceso" || o.Status == "Procesando")</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center">
                        <div class="metric-icon-circle bg-success bg-opacity-10 me-3 text-success">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold">Completados</span>
                            <h4 class="fw-bold mb-0 text-dark">@orders.Count(o => o.Status == "Completado")</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FILTROS Y BÚSQUEDA -->
            <div class="glass-card p-3 mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <div class="position-relative">
                            <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 1rem; transform: translateY(-50%);"></i>
                            <input type="text" class="form-control modern-input ps-5" placeholder="Buscar por ID de pedido..." @bind="searchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select modern-input" @bind="selectedStatusFilter">
                            <option value="">Todos los estados</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="EnProceso">En Proceso</option>
                            <option value="Completado">Completado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                    <div class="col-md-3 text-end text-muted small fw-medium">
                        Mostrando <span class="fw-bold text-dark">@FilteredOrders.Count</span> de @orders.Count pedidos
                    </div>
                </div>
            </div>

            <!-- TABLA DE PEDIDOS -->
            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Pedido ID</th>
                            <th>Fecha</th>
                            <th>Productos</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted"><div class="spinner-border text-primary spinner-border-sm me-2"></div> Cargando órdenes...</td></tr>
                        }
                        else if (!FilteredOrders.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2"></i> No se encontraron pedidos registrados.</td></tr>
                        }
                        else
                        {
                            @foreach (var order in FilteredOrders)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="font-monospace fw-bold text-dark">#@order.Id.ToString("D4")</span>
                                    </td>
                                    <td class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-box-seam me-1 text-primary"></i>@(order.Items?.Count ?? 0) ítems
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">$@order.Total.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetBadgeClass(order.Status)">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-light border text-primary me-1 rounded-3" title="Ver Detalles" @onclick="() => VerDetalles(order)">
                                            <i class="bi bi-eye-fill me-1"></i> Detalles
                                        </button>
                                        <button class="btn btn-sm btn-light border text-dark rounded-3" title="Cambiar Estado" @onclick="() => AbrirModalEstado(order)">
                                            <i class="bi bi-sliders me-1"></i> Estado
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL: DETALLES DEL PEDIDO -->
@if (showDetailsModal && selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg p-3">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-receipt me-2 text-primary"></i>Detalles del Pedido #@selectedOrder.Id.ToString("D4")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center p-3 mb-3 rounded-3 bg-light border">
                        <div>
                            <span class="text-muted small d-block">Fecha de creación</span>
                            <strong class="text-dark">@selectedOrder.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy - HH:mm:ss")</strong>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Estado actual</span>
                            <span class="badge @GetBadgeClass(selectedOrder.Status)">@selectedOrder.Status</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Monto Total</span>
                            <strong class="fs-5 text-success">$@selectedOrder.Total.ToString("N0")</strong>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2 text-secondary">Ítems comprados:</h6>
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Producto</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end pe-3">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (selectedOrder.Items != null && selectedOrder.Items.Any())
                                {
                                    @foreach (var item in selectedOrder.Items)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark">@item.ProductName</td>
                                            <td class="text-center"><span class="badge bg-secondary">x@(item.Quantity)</span></td>
                                            <td class="text-end pe-3 fw-bold text-success">$@item.Subtotal.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="3" class="text-center py-3 text-muted">No se detallaron ítems en este pedido.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-2">
                    <button class="btn btn-light text-muted btn-modern" @onclick="CerrarModales">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: CAMBIO DE ESTADO -->
@if (showStatusModal && selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg p-3">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Actualizar Estado - Pedido #@selectedOrder.Id.ToString("D4")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small text-muted fw-bold mb-3">Selecciona el nuevo estado para el pedido:</label>
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var statusOption in new[] { "Pendiente", "EnProceso", "Completado", "Cancelado" })
                        {
                            bool isSelected = newStatus == statusOption;
                            <div class="p-3 border rounded-3 transition-all d-flex align-items-center justify-content-between @(isSelected ? "bg-light border-primary shadow-sm" : "")"
                                 style="cursor: pointer;" @onclick="() => newStatus = statusOption">
                                <div class="d-flex align-items-center gap-2">
                                    <input class="form-check-input mt-0" type="radio" name="orderStatusRadio" checked="@isSelected">
                                    <span class="fw-bold text-dark">@statusOption</span>
                                </div>
                                <span class="badge @GetBadgeClass(statusOption)">@statusOption</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-light text-muted btn-modern" @onclick="CerrarModales">Cancelar</button>
                    <button class="btn btn-primary-modern btn-modern px-4" @onclick="GuardarNuevoEstado" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OrderResponse> orders = new();
    private string searchTerm = string.Empty;
    private string selectedStatusFilter = string.Empty;
    private bool isLoading = true;
    private bool isBusy;

    private OrderResponse? selectedOrder;
    private bool showDetailsModal;
    private bool showStatusModal;
    private string newStatus = string.Empty;

    private List<OrderResponse> FilteredOrders => orders
        .Where(o => string.IsNullOrWhiteSpace(searchTerm) || o.Id.ToString().Contains(searchTerm.Trim()))
        .Where(o => string.IsNullOrWhiteSpace(selectedStatusFilter) || o.Status.Equals(selectedStatusFilter, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(o => o.CreatedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (Session.IsWorker)
        {
            await CargarPedidos();
        }
        else
        {
            isLoading = false;
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task CargarPedidos()
    {
        isLoading = true;
        var result = await Api.GetAllOrdersAsync();
        isLoading = false;
        
        if (result.Ok)
        {
            orders = result.Data ?? new();
        }
        else
        {
            Toast.ShowError(result.Error ?? "Error al obtener el historial de pedidos.");
        }
    }

    private void VerDetalles(OrderResponse order)
    {
        selectedOrder = order;
        showDetailsModal = true;
    }

    private void AbrirModalEstado(OrderResponse order)
    {
        selectedOrder = order;
        newStatus = order.Status;
        showStatusModal = true;
    }

    private void CerrarModales()
    {
        showDetailsModal = false;
        showStatusModal = false;
        selectedOrder = null;
    }

    private async Task GuardarNuevoEstado()
    {
        if (selectedOrder == null || string.IsNullOrWhiteSpace(newStatus)) return;
        
        isBusy = true;
        var result = await Api.UpdateOrderStatusAsync(selectedOrder.Id, newStatus);
        isBusy = false;

        if (result.Ok)
        {
            Toast.ShowSuccess($"El pedido #{selectedOrder.Id} cambió a estado '{newStatus}'.");
            CerrarModales();
            await CargarPedidos();
        }
        else
        {
            Toast.ShowError(result.Error ?? "No se pudo actualizar el estado del pedido.");
        }
    }

    private string GetBadgeClass(string status) => status switch
    {
        "Pendiente" => "badge-soft-warning",
        "EnProceso" or "Procesando" => "badge-soft-info",
        "Completado" => "badge-soft-success",
        "Cancelado" => "badge-soft-danger",
        _ => "badge-soft-primary"
    };

    public void Dispose() => Session.Changed -= OnSessionChanged;
}