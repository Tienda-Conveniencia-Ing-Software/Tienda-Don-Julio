@page "/"
@inject AuthSession Session

<PageTitle>Tienda Don Julio</PageTitle>

<h1>Tienda Don Julio</h1>

@if (Session.IsLoggedIn)
{
    <p class="lead">Hola, <strong>@Session.Nombre</strong>. Usa el menú de la izquierda para continuar.</p>
}
else
{
    <p class="lead">Consulta el catálogo de productos o <a href="login">inicia sesión</a> para gestionar el inventario.</p>
}
