@page "/inventario"
@using TiendaBarrio.Core.Models
@inject HttpClient Http

<PageTitle>Inventario - TiendaBarrio</PageTitle>

<h3>Catálogo de Productos e Inventario</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<!-- Formulario para agregar producto -->
<div class="card mb-4">
    <div class="card-header fw-bold">Registrar Nuevo Producto</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <input class="form-control" placeholder="Nombre" @bind="newProductName" />
            </div>
            <div class="col-md-2">
                <input type="number" step="0.01" class="form-control" placeholder="Precio Venta" @bind="newProductPrice" />
            </div>
            <div class="col-md-2">
                <input type="number" step="0.01" class="form-control" placeholder="Precio Compra" @bind="newProductPurchasePrice" />
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" placeholder="Stock" @bind="newProductStock" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" @onclick="RegistrarProducto">Agregar Producto</button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de productos -->
<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio Venta</th>
            <th>Precio Compra</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (productos == null || !productos.Any())
        {
            <tr>
                <td colspan="6" class="text-center">No hay productos registrados en el inventario.</td>
            </tr>
        }
        else
        {
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.ID</td>
                    <td>@prod.Name</td>
                    <td>$@prod.Price.ToString("N2")</td>
                    <td>$@prod.PurchasePrice.ToString("N2")</td>
                    <td>@prod.Stock</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarProducto(prod.ID)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Product> productos = new();
    private string newProductName = string.Empty;
    private double newProductPrice;
    private double newProductPurchasePrice;
    private int newProductStock;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<Product>>("api/inventory") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar inventario desde la API: " + ex.Message;
        }
    }

    private async Task RegistrarProducto()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newProductName))
            {
                errorMessage = "El nombre del producto es obligatorio.";
                return;
            }

            var request = new { Name = newProductName, Price = newProductPrice, PurchasePrice = newProductPurchasePrice, Stock = newProductStock };
            var response = await Http.PostAsJsonAsync("api/inventory", request);

            if (response.IsSuccessStatusCode)
            {
                newProductName = string.Empty;
                newProductPrice = 0;
                newProductPurchasePrice = 0;
                newProductStock = 0;
                await CargarProductos();
            }
            else
            {
                errorMessage = "No se pudo registrar el producto.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de comunicación con la API: " + ex.Message;
        }
    }

    private async Task EliminarProducto(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/inventory/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CargarProductos();
            }
            else
            {
                errorMessage = "No se pudo eliminar el producto.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al conectar con la API: " + ex.Message;
        }
    }
}