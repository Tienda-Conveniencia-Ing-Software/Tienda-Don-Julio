@page "/inventario"
@implements IDisposable
@inject ApiClient Api
@inject AuthSession Session

<PageTitle>Inventario - Tienda Don Julio</PageTitle>

<h3>Catálogo de productos e inventario</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (Session.IsWorker)
{
    <div class="card mb-4">
        <div class="card-header fw-bold">Registrar nuevo producto</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <input class="form-control" placeholder="Nombre" @bind="newProductName" />
                </div>
                <div class="col-md-2">
                    <input type="number" step="0.01" class="form-control" placeholder="Precio venta" @bind="newProductPrice" />
                </div>
                <div class="col-md-2">
                    <input type="number" step="0.01" class="form-control" placeholder="Precio compra" @bind="newProductPurchasePrice" />
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control" placeholder="Stock" @bind="newProductStock" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-success w-100" @onclick="RegistrarProducto" disabled="@isBusy">Agregar producto</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Estás viendo el catálogo en modo lectura.
        <a href="login">Inicia sesión como Trabajador</a> para agregar o eliminar productos.
    </div>
}

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio venta</th>
            <th>Precio compra</th>
            <th>Stock</th>
            @if (Session.IsWorker)
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (isLoading)
        {
            <tr><td colspan="6" class="text-center">Cargando...</td></tr>
        }
        else if (productos.Count == 0)
        {
            <tr><td colspan="6" class="text-center">No hay productos registrados en el inventario.</td></tr>
        }
        else
        {
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.Id</td>
                    <td>@prod.Name</td>
                    <td>$@prod.Price.ToString("N2")</td>
                    <td>$@prod.PurchasePrice.ToString("N2")</td>
                    <td>@prod.Stock</td>
                    @if (Session.IsWorker)
                    {
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarProducto(prod.Id)" disabled="@isBusy">Eliminar</button>
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<ProductItem> productos = new();
    private string newProductName = string.Empty;
    private double newProductPrice;
    private double newProductPurchasePrice;
    private int newProductStock;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await CargarProductos();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task CargarProductos()
    {
        isLoading = true;
        var result = await Api.GetProductsAsync();
        isLoading = false;

        if (result.Ok)
            productos = result.Data ?? new();
        else
            errorMessage = result.Error;
    }

    private async Task RegistrarProducto()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newProductName))
        {
            errorMessage = "El nombre del producto es obligatorio.";
            return;
        }

        isBusy = true;
        var result = await Api.CreateProductAsync(newProductName.Trim(), newProductPrice, newProductPurchasePrice, newProductStock);
        isBusy = false;

        if (result.Ok)
        {
            newProductName = string.Empty;
            newProductPrice = 0;
            newProductPurchasePrice = 0;
            newProductStock = 0;
            await CargarProductos();
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    private async Task EliminarProducto(int id)
    {
        errorMessage = null;
        isBusy = true;
        var result = await Api.DeleteProductAsync(id);
        isBusy = false;

        if (result.Ok)
            await CargarProductos();
        else
            errorMessage = result.Error;
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
