@page "/inventario"
@using TiendaBarrio.Core.Services
@using TiendaBarrio.Core.Models
@inject InventoryService InventoryService
@inject TiendaBarrio.Persistence.Interfaces.IProductRepository ProductRepository

<PageTitle>Inventario - TiendaBarrio</PageTitle>

<h3>Gestión de Inventario</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

<!-- Formulario para agregar/modificar stock (Solo accesible visualmente si es relevante) -->
<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        Acciones de Inventario (Requiere Rol Trabajador)
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <input type="text" class="form-control" placeholder="Nombre Producto" @bind="newProductName" />
            </div>
            <div class="col-md-2">
                <input type="number" step="0.01" class="form-control" placeholder="Precio Venta" @bind="newProductPrice" />
            </div>
            <div class="col-md-2">
                <input type="number" step="0.01" class="form-control" placeholder="Precio Compra" @bind="newProductPurchasePrice" />
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" placeholder="Stock Inicial" @bind="newProductStock" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="RegistrarProducto">Registrar Producto</button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Productos -->
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio Venta</th>
            <th>Precio Compra</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (productos == null || !productos.Any())
        {
            <tr>
                <td colspan="6" class="text-center">No hay productos registrados en el inventario.</td>
            </tr>
        }
        else
        {
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.ID</td>
                    <td>@prod.Name</td>
                    <td>$@prod.Price.ToString("F2")</td>
                    <td>$@prod.PurchasePrice.ToString("F2")</td>
                    <td>
                        <span class="badge @(prod.Stock > 5 ? "bg-success" : "bg-warning text-dark")">
                            @prod.Stock
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProducto(prod.ID)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Product> productos = new();
    private string? errorMessage;
    private string? successMessage;

    // Campos del formulario
    private string newProductName = string.Empty;
    private double newProductPrice;
    private double newProductPurchasePrice;
    private int newProductStock;

    // TODO: Persona 1 - Sustituir este mock por la sesión del usuario autenticado vía JWT/Claims
    private Cliente usuarioSesion = new Cliente
    {
        Id = 1,
        Nombre = "Trabajador Demo",
        Role = "Trabajador" // Cambiar a "Cliente" para probar el bloqueo de seguridad
    };

    protected override void OnInitialized()
    {
        CargarProductos();
    }

    private void CargarProductos()
    {
        try
        {
            // TODO: Persona 1 (API) - Reemplazar por GET /api/inventory cuando los endpoints estén listos
            productos = ProductRepository.LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar inventario: " + ex.Message;
        }
    }

    private void RegistrarProducto()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            InventoryService.RegisterProduct(usuarioSesion, productos, newProductName, newProductPrice, newProductPurchasePrice, newProductStock);
            successMessage = $"Producto '{newProductName}' registrado correctamente.";
            
            // Limpiar campos y recargar
            newProductName = string.Empty;
            newProductPrice = 0;
            newProductPurchasePrice = 0;
            newProductStock = 0;
            CargarProductos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EliminarProducto(int id)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            InventoryService.DeleteProduct(usuarioSesion, productos, id);
            successMessage = $"Producto #{id} eliminado correctamente.";
            CargarProductos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}