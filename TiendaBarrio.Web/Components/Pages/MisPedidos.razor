@page "/mis-pedidos"
@inject ApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Mis Pedidos - Tienda Don Julio</PageTitle>

<h2 class="fw-bold mb-4">Mis Pedidos</h2>

@if (!Session.IsLoggedIn)
{
    <div class="alert alert-warning">
        Debes <a href="/login" class="alert-link">Iniciar Sesión</a> para ver tu historial de pedidos.
    </div>
}
else if (isLoading)
{
    <div class="spinner-border text-success" role="status"><span class="visually-hidden">Cargando...</span></div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (orders == null || !orders.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center">
        <p class="text-muted mb-0">Aún no has realizado ningún pedido.</p>
        <div class="mt-3">
            <a href="/catalogo" class="btn btn-success fw-semibold">Ir al Catálogo</a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var o in orders)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <div>
                        <strong class="fs-6">Pedido #@o.Id</strong>
                        <span class="text-muted ms-2"><small>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></span>
                    </div>
                    <div>
                        <span class="badge @GetStatusBadge(o.Status) fs-6">@o.Status</span>
                    </div>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var item in o.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                <span>@item.ProductName x @item.Quantity</span>
                                <strong>$@item.Subtotal.ToString("N0")</strong>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold">Total del Pedido:</span>
                        <span class="fs-5 fw-bold text-success">$@o.Total.ToString("N0")</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<OrderResponse>? orders;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsLoggedIn)
        {
            var res = await Api.GetMyOrdersAsync();
            if (res.Ok) orders = res.Data;
            else error = res.Error;
        }
        isLoading = false;
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Pendiente" => "bg-warning text-dark",
        "EnProceso" => "bg-info text-dark",
        "Completado" => "bg-success",
        "Cancelado" => "bg-danger",
        _ => "bg-secondary"
    };
}