@page "/mis-pedidos"
@implements IDisposable
@using TiendaBarrio.Web.Models
@using TiendaBarrio.Web.Services
@inject ApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Mis Pedidos - Tienda Don Julio</PageTitle>

<div class="dashboard-bg pt-4">
    <div class="container-fluid px-4">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bolder mb-1" style="color: #0f172a; letter-spacing: -0.025em;">Mis Pedidos</h2>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Historial de compras realizadas en tu cuenta.</p>
            </div>
        </div>

        <div class="glass-card p-4">
            @if (!Session.IsLoggedIn)
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Debes <a href="/login" class="alert-link">Iniciar Sesión</a> para ver tu historial de pedidos.
                </div>
            }
            else if (isLoading)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary spinner-border-sm me-2"></div> Cargando historial de pedidos...
                </div>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger mb-0">@error</div>
            }
            else if (orders == null || !orders.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <h5 class="fw-bold text-dark">Aún no has realizado ningún pedido</h5>
                    <p class="text-muted mb-4">Explora el catálogo de productos disponibles en la tienda.</p>
                    <a href="/catalogo" class="btn btn-primary-modern btn-modern px-4">Ir al Catálogo</a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var o in orders)
                    {
                        <div class="border rounded-3 p-3 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                <div>
                                    <strong class="fs-6 text-dark">Pedido #@o.Id.ToString("D4")</strong>
                                    <span class="text-muted ms-2 small"><i class="bi bi-calendar3 me-1"></i>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <span class="badge @GetStatusBadge(o.Status)">@o.Status</span>
                            </div>
                            <div class="mb-2">
                                @if (o.Items != null)
                                {
                                    @foreach (var item in o.Items)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1">
                                            <span class="text-dark">@item.ProductName <small class="text-muted">x@(item.Quantity)</small></span>
                                            <strong class="text-dark">$@item.Subtotal.ToString("N0")</strong>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fw-bold text-muted">Total del Pedido:</span>
                                <span class="fs-5 fw-bold text-success">$@o.Total.ToString("N0")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<OrderResponse>? orders;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (Session.IsLoggedIn)
        {
            var res = await Api.GetMyOrdersAsync();
            if (res.Ok) orders = res.Data;
            else error = res.Error;
        }
        isLoading = false;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private string GetStatusBadge(string status) => status switch
    {
        "Pendiente" => "badge-soft-warning",
        "EnProceso" or "Procesando" => "badge-soft-info",
        "Completado" => "badge-soft-success",
        "Cancelado" => "badge-soft-danger",
        _ => "badge-soft-primary"
    };

    public void Dispose() => Session.Changed -= OnSessionChanged;
}