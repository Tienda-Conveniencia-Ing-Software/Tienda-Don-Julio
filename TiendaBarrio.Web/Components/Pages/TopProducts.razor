@page "/top-products"
@implements IDisposable
@using TiendaBarrio.Web.Models
@using TiendaBarrio.Web.Services
@inject ApiClient Api
@inject AuthSession Session
@inject ToastService Toast

<PageTitle>Más Vendidos - Tienda Don Julio</PageTitle>

<div class="dashboard-bg">
    <div class="container-fluid px-4">
        
        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bolder mb-1" style="color: #0f172a; letter-spacing: -0.025em;">Productos Más Vendidos</h2>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Ranking del catálogo basado en el volumen total de ventas.</p>
            </div>
            <button class="btn btn-modern btn-light border shadow-sm" @onclick="CargarTopProducts">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
            </button>
        </div>

        @if (!Session.IsWorker)
        {
            <div class="glass-card p-4 text-center my-4">
                <i class="bi bi-shield-lock fs-1 text-warning d-block mb-2"></i>
                <h5 class="fw-bold text-dark">Acceso Restringido</h5>
                <p class="text-muted mb-0">Esta sección es visible únicamente para el personal autorizado.</p>
            </div>
        }
        else
        {
            <div class="glass-card p-4 mb-4 shadow-sm" style="background: rgba(255, 255, 255, 0.85);">
                <div class="table-responsive">
                    <table class="table table-modern align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 100px;"># Posición</th>
                                <th>Producto</th>
                                <th class="text-center">Cantidad Vendida</th>
                                <th class="text-end pe-4">Ingresos Totales</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="4" class="text-center py-5 text-muted"><div class="spinner-border text-primary spinner-border-sm me-2"></div> Cargando ranking...</td></tr>
                            }
                            else if (items == null || !items.Any())
                            {
                                <tr><td colspan="4" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2"></i> No hay datos de ventas registrados.</td></tr>
                            }
                            else
                            {
                                @for (int i = 0; i < items.Count; i++)
                                {
                                    var item = items[i];
                                    int rank = i + 1;
                                    string badgeRankClass = rank switch
                                    {
                                        1 => "bg-warning text-dark",
                                        2 => "bg-secondary text-white",
                                        3 => "bg-danger bg-opacity-75 text-white",
                                        _ => "bg-light text-dark border"
                                    };

                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge rounded-circle p-2 fw-bold d-inline-flex align-items-center justify-content-center @badgeRankClass" style="width: 28px; height: 28px;">
                                                @rank
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@item.ProductName</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-soft-primary">
                                                <i class="bi bi-box-seam me-1"></i>@(item.TotalQuantitySold) uds
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold text-success fs-6">$@(item.TotalRevenue.ToString("N0"))</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<TopProductItem> items = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (Session.IsWorker)
        {
            await CargarTopProducts();
        }
        else
        {
            isLoading = false;
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task CargarTopProducts()
    {
        isLoading = true;
        var res = await Api.GetTopProductsAsync();
        isLoading = false;

        if (res.Ok)
        {
            items = res.Data ?? new();
        }
        else
        {
            Toast.ShowError(res.Error ?? "Error al obtener el ranking de ventas.");
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}