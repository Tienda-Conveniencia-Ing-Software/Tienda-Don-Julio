@page "/catalogo"
@inject ApiClient Api
@inject CartState Cart
@inject AuthSession Session
@inject NavigationManager Nav
<div class="dashboard-bg pt-4"><div class="container-fluid px-4">
        <PageTitle>Catálogo & Carrito - Tienda Don Julio</PageTitle>

        <div class="row g-4">
            <!-- Columna Catálogo -->
            <div class="col-lg-8">
                <h2 class="mb-3 fw-bold">Catálogo de Productos</h2>

                @if (isLoading)
                {
                    <div class="spinner-border text-success" role="status"><span class="visually-hidden">Cargando...</span></div>
                }
                else if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger">@error</div>
                }
                else if (products == null || !products.Any())
                {
                    <p class="text-muted">No hay productos disponibles por ahora.</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                        @foreach (var p in products)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title fw-bold">@p.Name</h5>
                                        <p class="card-text text-muted mb-1">Precio: <strong class="text-dark">$@p.Price.ToString("N0")</strong></p>
                                        <p class="card-text text-muted mb-3"><small>Stock disponible: @p.Stock</small></p>

                                        <div class="mt-auto">
                                            <button class="btn btn-outline-success w-100 fw-semibold" 
                                                    disabled="@(p.Stock <= 0)" 
                                                    @onclick="() => Cart.AddProduct(p, 1)">
                                                @(p.Stock > 0 ? "Añadir al Carrito" : "Agotado")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Columna Carrito (Checkout) -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 1rem;">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="card-title mb-0 fw-bold">🛒 Mi Carrito</h5>
                    </div>
                    <div class="card-body">
                        @if (!Cart.Items.Any())
                        {
                            <p class="text-muted text-center py-4 mb-0">Tu carrito está vacío.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var item in Cart.Items)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                        <div>
                                            <h6 class="mb-0 fw-semibold">@item.Name</h6>
                                            <small class="text-muted">$@item.UnitPrice.ToString("N0") c/u</small>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="number" class="form-control form-control-sm text-center" style="width: 60px;"
                                                   value="@item.Quantity" 
                                                   min="1" max="@item.MaxStock"
                                                   @onchange="@(e => Cart.UpdateQuantity(item.ProductId, int.TryParse(e.Value?.ToString(), out var q) ? q : 1))" />
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Cart.RemoveItem(item.ProductId)">✕</button>
                                        </div>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between align-items-center fs-5 mb-3">
                                <span class="fw-bold">Total:</span>
                                <span class="fw-bold text-success">$@Cart.Total.ToString("N0")</span>
                            </div>

                            @if (!string.IsNullOrEmpty(checkoutError))
                            {
                                <div class="alert alert-danger py-2 mb-3">@checkoutError</div>
                            }

                            <button class="btn btn-success w-100 py-2 fw-bold" disabled="@isProcessingCheckout" @onclick="ProcessCheckout">
                                @(isProcessingCheckout ? "Procesando..." : "Realizar Pedido (Checkout)")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    private List<ProductItem>? products;
    private bool isLoading = true;
    private string? error;
    private string? checkoutError;
    private bool isProcessingCheckout;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += StateHasChanged;
        var res = await Api.GetProductsAsync();
        if (res.Ok) products = res.Data;
        else error = res.Error;
        isLoading = false;
    }

    private async Task ProcessCheckout()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        isProcessingCheckout = true;
        checkoutError = null;

        var req = new CreateOrderRequest
        {
            ClienteId = Session.IsLoggedIn ? 1 : 0,
            Items = Cart.Items.Select(i => new CreateOrderItem { ProductId = i.ProductId, Quantity = i.Quantity }).ToList()
        };

        var result = await Api.CreateOrderAsync(req);

        if (result.Ok)
        {
            Cart.Clear();
            Nav.NavigateTo("/mis-pedidos");
        }
        else
        {
            checkoutError = result.Error ?? "Error al procesar el checkout.";
        }

        isProcessingCheckout = false;
    }

    public void Dispose() => Cart.OnChange -= StateHasChanged;
}