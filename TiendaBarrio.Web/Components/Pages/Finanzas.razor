@page "/finanzas"
@implements IDisposable
@using TiendaBarrio.Web.Models
@using TiendaBarrio.Web.Services
@inject ApiClient Api
@inject AuthSession Session
@inject ToastService Toast

<PageTitle>Finanzas y Caja - Tienda Don Julio</PageTitle>

<div class="dashboard-bg pt-4">
    <div class="container-fluid px-4">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bolder mb-1" style="color: #0f172a; letter-spacing: -0.025em;">Flujo de Caja y Finanzas</h2>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Balance general, ingresos acumulados y registro de gastos.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-modern btn-light border shadow-sm" @onclick="CargarFinanzas">
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                </button>
                @if (Session.IsWorker)
                {
                    <span class="badge badge-soft-primary shadow-sm"><i class="bi bi-shield-check me-1"></i> Modo Administrador</span>
                }
            </div>
        </div>

        @if (!Session.IsWorker)
        {
            <div class="glass-card p-4 text-center my-4">
                <i class="bi bi-shield-lock fs-1 text-warning d-block mb-2"></i>
                <h5 class="fw-bold text-dark">Acceso Restringido</h5>
                <p class="text-muted mb-0">Esta sección es visible únicamente para el personal con rol de <strong>Trabajador</strong>.</p>
            </div>
        }
        else
        {
            <!-- TARJETAS DE MÉTRICAS FINANCIERAS CORREGIDAS -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="glass-card p-4 d-flex align-items-center">
                        <div class="metric-icon-circle bg-success bg-opacity-10 text-success me-3">
                            <i class="bi bi-graph-up-arrow fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Ingresos Totales</span>
                            <h3 class="fw-bold mb-0 text-success">$@balance.TotalIncome.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card p-4 d-flex align-items-center">
                        <div class="metric-icon-circle bg-danger bg-opacity-10 text-danger me-3">
                            <i class="bi bi-graph-down-arrow fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Gastos Totales</span>
                            <h3 class="fw-bold mb-0 text-danger">$@balance.TotalExpense.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card p-4 d-flex align-items-center">
                        <div class="metric-icon-circle bg-primary bg-opacity-10 text-primary me-3">
                            <i class="bi bi-wallet2 fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Saldo Actual en Caja</span>
                            <h3 class="fw-bold mb-0 text-dark">$@balance.CurrentBalance.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLA DE MOVIMIENTOS DE CAJA -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>Movimientos de Caja</h5>
                <div class="text-muted small fw-medium">
                    Total registros: <span class="fw-bold text-dark">@movements.Count</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Tipo</th>
                            <th>Monto</th>
                            <th>Descripción</th>
                            <th class="text-end pe-4">Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr><td colspan="5" class="text-center py-5 text-muted"><div class="spinner-border text-primary spinner-border-sm me-2"></div> Sincronizando finanzas...</td></tr>
                        }
                        else if (!movements.Any())
                        {
                            <tr><td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2"></i> No hay movimientos registrados en la caja.</td></tr>
                        }
                        else
                        {
                            @foreach (var mov in movements)
                            {
                                <tr>
                                    <td class="ps-4"><span class="font-monospace text-muted">#@mov.Id.ToString("D4")</span></td>
                                    <td>
                                        <span class="badge @BadgeClass(mov.Type)">
                                            @mov.Type
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold @(mov.Type == "Ingreso" ? "text-success" : "text-danger")">
                                            $@mov.Amount.ToString("N2")
                                        </span>
                                    </td>
                                    <td class="text-dark fw-medium">@mov.Description</td>
                                    <td class="text-end pe-4 text-muted"><i class="bi bi-clock me-1"></i>@mov.Date.ToString("g")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private BalanceInfo balance = new();
    private List<MovementItem> movements = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (Session.IsWorker)
        {
            await CargarFinanzas();
        }
        else
        {
            isLoading = false;
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task CargarFinanzas()
    {
        isLoading = true;
        
        var balanceResult = await Api.GetBalanceAsync();
        if (balanceResult.Ok)
        {
            balance = balanceResult.Data ?? new();
        }
        else
        {
            Toast.ShowError(balanceResult.Error ?? "No se pudo obtener el balance general.");
        }

        var movementsResult = await Api.GetMovementsAsync();
        if (movementsResult.Ok)
        {
            movements = movementsResult.Data ?? new();
        }
        else
        {
            Toast.ShowError(movementsResult.Error ?? "No se pudo cargar el historial de movimientos.");
        }

        isLoading = false;
    }

    private static string BadgeClass(string type) => type switch
    {
        "Ingreso" => "badge-soft-success",
        "Gasto" => "badge-soft-danger",
        _ => "badge-soft-warning"
    };

    public void Dispose() => Session.Changed -= OnSessionChanged;
}