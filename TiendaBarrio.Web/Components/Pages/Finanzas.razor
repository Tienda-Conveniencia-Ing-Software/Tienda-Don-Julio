@page "/finanzas"
@using TiendaBarrio.Core.Models
@inject HttpClient Http

<PageTitle>Gestión Financiera - TiendaBarrio</PageTitle>

<h3>Flujo de Caja y Finanzas</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<div class="card mb-4 border-primary">
    <div class="card-body text-center">
        <h5 class="card-title text-muted">Saldo Actual en Caja</h5>
        <h2 class="display-6 fw-bold text-success">$@balance.ToString("N2")</h2>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tipo</th>
            <th>Monto</th>
            <th>Descripción</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @if (movements == null || !movements.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No hay movimientos registrados en la caja.</td>
            </tr>
        }
        else
        {
            @foreach (var mov in movements)
            {
                <tr>
                    <td>@mov.Id</td>
                    <td>
                        <span class="badge @(mov.Type == MovementType.Ingreso ? "bg-success" : "bg-danger")">
                            @mov.Type
                        </span>
                    </td>
                    <td>$@mov.Amount.ToString("N2")</td>
                    <td>@mov.Description</td>
                    <td>@mov.Date.ToString("g")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private double balance;
    private List<CashMovement> movements = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarFinanzas();
    }

    private async Task CargarFinanzas()
    {
        try
        {
            balance = await Http.GetFromJsonAsync<double>("api/finance/balance");
            movements = await Http.GetFromJsonAsync<List<CashMovement>>("api/finance/movements") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar los datos financieros desde la API: " + ex.Message;
        }
    }
}