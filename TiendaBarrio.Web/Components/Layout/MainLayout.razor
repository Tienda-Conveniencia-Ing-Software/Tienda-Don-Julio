@using TiendaBarrio.Web.Components.Shared
@using TiendaBarrio.Web.Services
@inject AuthSession Session
@inherits LayoutComponentBase

<div class="d-flex" style="min-height: 100vh; height: 100vh; overflow: hidden; background: linear-gradient(135deg, #e2eafc 0%, #edf2f7 100%);">
    <!-- Sidebar con ancho dinámico -->
    <div class="sidebar-container @(isCollapsed ? "sidebar-collapsed" : "")" style="width: @(isCollapsed ? "80px" : "260px"); flex-shrink: 0; z-index: 100; height: 100vh;">
        <NavMenu IsCollapsed="isCollapsed" OnToggleCollapse="ToggleSidebar" />
    </div>

    <!-- Contenido Principal -->
    <main class="flex-grow-1" style="overflow-y: auto; height: 100vh; overflow-x: hidden;">
        @Body
    </main>
</div>

<ToastContainer />

@code {
    private bool isCollapsed = false;

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }
}