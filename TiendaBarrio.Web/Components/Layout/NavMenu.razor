@implements IDisposable
@inject AuthSession Session
@inject CartState Cart
@inject ApiClient Api
@inject NavigationManager Navigation

<div>
	<div class="top-row ps-3 navbar navbar-dark">
		<div class="container-fluid">
			<a class="navbar-brand" href="">Tienda Don Julio</a>
		</div>
	</div>

	<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

	<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
		<nav class="flex-column">

			<div class="nav-item px-3">
				<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
					<span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
				</NavLink>
			</div>

			<!-- Portal Cliente / Compras -->
			<div class="nav-item px-3">
				<NavLink class="nav-link" href="catalogo">
					<span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> Catálogo
					@if (Cart.Count > 0)
					{
						<span class="badge bg-warning text-dark ms-auto">@Cart.Count</span>
					}
				</NavLink>
			</div>

			@if (Session.IsLoggedIn)
			{
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="mis-pedidos">
						<span class="bi bi-bag-check-fill-nav-menu" aria-hidden="true"></span> Mis Pedidos
					</NavLink>
				</div>
			}

			<!-- Panel de Control e Inventario -->
			<div class="nav-item px-3">
				<NavLink class="nav-link" href="inventario">
					<span class="bi bi-box-seam-fill-nav-menu" aria-hidden="true"></span> Inventario
				</NavLink>
			</div>

			@if (Session.IsWorker)
			{
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="finanzas">
						<span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> Finanzas
					</NavLink>
				</div>

				<!--  Solo los trabajadores pueden ver el reporte de más vendidos -->
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="top-products">
						<span class="bi bi-graph-up" aria-hidden="true"></span> Más Vendidos
					</NavLink>
				</div>

				<div class="nav-item px-3">
    				<NavLink class="nav-link" href="orders">
        				<span class="bi bi-list-check" aria-hidden="true"></span> Pedidos
    				</NavLink>
				</div>
			}

			<!-- Estado de Sesión -->
			@if (Session.IsLoggedIn)
			{
				<div class="nav-item px-3 text-white-50 small mt-3 border-top pt-2">
					@Session.Nombre<br />
					<span class="badge bg-secondary">@Session.Role</span>
				</div>
				<div class="nav-item px-3 mt-2">
					<button class="btn btn-sm btn-outline-light w-100" @onclick="CerrarSesion">Cerrar sesión</button>
				</div>
			}
			else
			{
				<div class="nav-item px-3 mt-2">
					<NavLink class="nav-link" href="login">
						<span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Iniciar sesión
					</NavLink>
				</div>

			}
		</nav>
	</div>
</div>

@code {
	protected override void OnInitialized()
	{
		Session.Changed += OnStateChanged;
		Cart.OnChange += OnStateChanged;
	}

	private void OnStateChanged() => InvokeAsync(StateHasChanged);

	private void CerrarSesion()
	{
		Api.Logout();
		Navigation.NavigateTo("login");
	}

	public void Dispose()
	{
		Session.Changed -= OnStateChanged;
		Cart.OnChange -= OnStateChanged;
	}
}